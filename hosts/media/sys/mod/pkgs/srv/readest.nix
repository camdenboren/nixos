# Based on the self-host compose shipped in readest/docker/compose.yaml.
#
# readest-src tracks main so `nix flake update` moves the SQL with the
# semver-tracked image. The image tag drops the Git tag's "v" (0.12.20 vs
# v0.12.20). Migrations are additive; if the image is newer than the last
# source bump, run `nix flake update` before rebuilding.
# The SQL migrations under docker/volumes/db are not independently versioned.
#
# The images are pinned through common/drv/container-images and loaded via
# imageFile in both production and the VM test.
# sources.json keys: readest, supabase-postgres, supabase-gotrue, postgrest,
# kong, rustfs. supabase-postgres tracks four-part 15.x tags; moving to Postgres
# 17 is a manual major upgrade (pg_upgrade/dump-restore).

{
  pkgs,
  lib,
  config,
  inputs,
  ...
}:

let
  src = inputs.readest-src;
  url = "https://read.home.local";
  network = "readest_default";

  # readest.yaml (server): POSTGRES_PASSWORD, PGPASSWORD, JWT_SECRET,
  # GOTRUE_JWT_SECRET, GOTRUE_DB_DATABASE_URL, PGRST_DB_URI, PGRST_JWT_SECRET,
  # PGRST_APP_SETTINGS_JWT_SECRET, SUPABASE_ANON_KEY, SUPABASE_SERVICE_KEY,
  # MINIO_ROOT_USER, MINIO_ROOT_PASSWORD (RustFS compatibility aliases).
  # readest-client.yaml: SUPABASE_ANON_KEY, SUPABASE_ADMIN_KEY,
  # S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY.
  serverSecrets = config.sops.secrets.readest.path;
  clientSecrets = config.sops.secrets.readest-client.path;

  schema = "${src}/docker/volumes/db/init/schema.sql";
  migrations = "${src}/docker/volumes/db/migrations";
  applyMigrations = "${src}/docker/volumes/db/apply-migrations.sh";
  roles = "${src}/docker/volumes/db/roles.sql";
  jwt = "${src}/docker/volumes/db/jwt.sql";
  kongConfig = "${src}/docker/volumes/api/kong.yml";

  bucket = "readest-files";

  # Use the digest-pinned archives in both production and the VM test so the
  # test can start the stack without pulling from the network.
  image = name: pkgs.container-images.${name}.passthru.imageRef;
  imageFile = name: pkgs.container-images.${name};
in
{
  # Runtime
  virtualisation.podman = {
    enable = true;
    autoPrune.enable = true;
    # weekly `podman system prune -f --all`: unused images only, never volumes
    autoPrune.flags = [ "--all" ];
    dockerCompat = true;
  };

  # Enable container name DNS for all Podman networks.
  networking.firewall.interfaces =
    let
      matchAll = if !config.networking.nftables.enable then "podman+" else "podman*";
    in
    {
      "${matchAll}".allowedUDPPorts = [ 53 ];
    };

  virtualisation.oci-containers.backend = "podman";

  # Containers
  virtualisation.oci-containers.containers."readest-client" = {
    image = image "readest";
    imageFile = imageFile "readest";
    pull = "missing";
    environment = {
      "API_BASE_URL" = url;
      "FONT_BASE_URL" = "";
      "OBJECT_STORAGE_TYPE" = "s3";
      "READEST_TRUSTED_PRIVATE_HOSTS" = "";
      "S3_BUCKET_NAME" = bucket;
      "S3_ENDPOINT" = "http://rustfs:9000";
      "S3_PUBLIC_ENDPOINT" = url;
      "S3_REGION" = "us-east-1";
      "SELF_HOSTED" = "true";
      "STORAGE_FIXED_QUOTA" = "107374182400";
      "SUPABASE_PUBLIC_URL" = url;
      "SUPABASE_URL" = "http://kong:8000";
      "TRANSLATION_FIXED_QUOTA" = "1000000";
    };
    environmentFiles = [ clientSecrets ];
    ports = [
      "127.0.0.1:3030:3000/tcp"
    ];
    dependsOn = [
      "readest-rustfs"
      "supabase-kong"
    ];
    log-driver = "journald";
    extraOptions = [
      "--network-alias=client"
      "--network=${network}"
    ];
  };
  systemd.services."podman-readest-client" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
    };
    unitConfig.Description = "Container readest-client generated by compose2nix.";
    after = [
      "podman-network-${network}.service"
      "readest-migrations.service"
      "readest-rustfs-setup.service"
    ];
    requires = [
      "podman-network-${network}.service"
      "readest-migrations.service"
      "readest-rustfs-setup.service"
    ];
    partOf = [
      "podman-compose-readest-root.target"
    ];
    wantedBy = [
      "podman-compose-readest-root.target"
    ];
  };

  virtualisation.oci-containers.containers."readest-rustfs" = {
    image = image "rustfs";
    imageFile = imageFile "rustfs";
    environment = {
      RUSTFS_ADDRESS = "0.0.0.0:9000";
      RUSTFS_CONSOLE_ADDRESS = "0.0.0.0:9001";
      RUSTFS_CONSOLE_CORS_ALLOWED_ORIGINS = "*";
      RUSTFS_CONSOLE_ENABLE = "true";
      RUSTFS_CORS_ALLOWED_ORIGINS = "*";
      RUSTFS_OBS_LOGGER_LEVEL = "info";
      RUSTFS_OBS_LOG_DIRECTORY = "/logs";
      RUSTFS_REGION = "us-east-1";
      RUSTFS_VOLUMES = "/data";
    };
    # RustFS accepts the MINIO_ROOT_USER/MINIO_ROOT_PASSWORD compatibility
    # aliases, so the existing server secret file needs no renaming.
    environmentFiles = [ serverSecrets ];
    volumes = [
      "readest_rustfs-data:/data:rw,U"
      "readest_rustfs-logs:/logs:rw,U"
    ];
    ports = [
      "127.0.0.1:9000:9000/tcp"
      "127.0.0.1:9011:9001/tcp"
    ];
    log-driver = "journald";
    extraOptions = [
      "--network-alias=rustfs"
      "--network=${network}"
      "--security-opt=no-new-privileges:true"
    ];
  };
  systemd.services."podman-readest-rustfs" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
    };
    unitConfig.Description = "Container readest-rustfs";
    after = [
      "podman-network-${network}.service"
      "podman-volume-readest_rustfs-data.service"
      "podman-volume-readest_rustfs-logs.service"
    ];
    requires = [
      "podman-network-${network}.service"
      "podman-volume-readest_rustfs-data.service"
      "podman-volume-readest_rustfs-logs.service"
    ];
    partOf = [
      "podman-compose-readest-root.target"
    ];
    wantedBy = [
      "podman-compose-readest-root.target"
    ];
  };

  virtualisation.oci-containers.containers."supabase-auth" = {
    image = image "supabase-gotrue";
    imageFile = imageFile "supabase-gotrue";
    environment = {
      "API_EXTERNAL_URL" = url;
      "GOTRUE_API_HOST" = "0.0.0.0";
      "GOTRUE_API_PORT" = "9999";
      "GOTRUE_DB_DRIVER" = "postgres";
      "GOTRUE_DISABLE_SIGNUP" = "true";
      "GOTRUE_EXTERNAL_ANONYMOUS_USERS_ENABLED" = "false";
      "GOTRUE_EXTERNAL_EMAIL_ENABLED" = "true";
      "GOTRUE_JWT_ADMIN_ROLES" = "service_role";
      "GOTRUE_JWT_AUD" = "authenticated";
      "GOTRUE_JWT_DEFAULT_GROUP_NAME" = "authenticated";
      "GOTRUE_JWT_EXP" = "3600";
      "GOTRUE_MAILER_AUTOCONFIRM" = "true";
      "GOTRUE_SITE_URL" = url;
      "GOTRUE_URI_ALLOW_LIST" = "${url}/**";
    };
    environmentFiles = [ serverSecrets ];
    log-driver = "journald";
    extraOptions = [
      "--network-alias=auth"
      "--network=${network}"
    ];
  };
  systemd.services."podman-supabase-auth" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
    };
    unitConfig.Description = "Container supabase-auth generated by compose2nix.";
    after = [
      "podman-network-${network}.service"
      "readest-migrations.service"
    ];
    requires = [
      "podman-network-${network}.service"
      "readest-migrations.service"
    ];
    partOf = [
      "podman-compose-readest-root.target"
    ];
    wantedBy = [
      "podman-compose-readest-root.target"
    ];
  };

  virtualisation.oci-containers.containers."supabase-db" = {
    image = image "supabase-postgres";
    imageFile = imageFile "supabase-postgres";
    environment = {
      "JWT_EXP" = "3600";
      "PGDATABASE" = "postgres";
      "PGPORT" = "5432";
      "POSTGRES_DB" = "postgres";
      "POSTGRES_HOST" = "/var/run/postgresql";
      "POSTGRES_PORT" = "5432";
    };
    environmentFiles = [ serverSecrets ];
    volumes = [
      # Only individual files are safe in the image's init directories; a
      # directory mount would shadow the Supabase core schema. Readest's base
      # schema and migrations are applied by readest-migrations.service instead.
      "${roles}:/docker-entrypoint-initdb.d/init-scripts/99-roles.sql:ro"
      "${jwt}:/docker-entrypoint-initdb.d/init-scripts/99-jwt.sql:ro"
      "${roles}:/readest-sql/roles.sql:ro"
      "${jwt}:/readest-sql/jwt.sql:ro"
      "${schema}:/readest-sql/schema.sql:ro"
      "${migrations}:/readest-migrations:ro"
      "${applyMigrations}:/readest-migrations.sh:ro"
      "readest_db-config:/etc/postgresql-custom:rw"
      "readest_db-data:/var/lib/postgresql/data:rw"
    ];
    cmd = [
      "postgres"
      "-c"
      "config_file=/etc/postgresql/postgresql.conf"
      "-c"
      "log_min_messages=fatal"
    ];
    log-driver = "journald";
    extraOptions = [
      "--network-alias=db"
      "--network=${network}"
    ];
  };
  systemd.services."podman-supabase-db" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
    };
    unitConfig.Description = "Container supabase-db generated by compose2nix.";
    after = [
      "podman-network-${network}.service"
      "podman-volume-readest_db-config.service"
      "podman-volume-readest_db-data.service"
    ];
    requires = [
      "podman-network-${network}.service"
      "podman-volume-readest_db-config.service"
      "podman-volume-readest_db-data.service"
    ];
    partOf = [
      "podman-compose-readest-root.target"
    ];
    wantedBy = [
      "podman-compose-readest-root.target"
    ];
  };

  virtualisation.oci-containers.containers."supabase-kong" = {
    image = image "kong";
    imageFile = imageFile "kong";
    environment = {
      "KONG_DATABASE" = "off";
      "KONG_DECLARATIVE_CONFIG" = "/home/kong/kong.yml";
      "KONG_DNS_ORDER" = "LAST,A,CNAME";
      "KONG_PLUGINS" = "request-transformer,cors,key-auth,acl,basic-auth";
    };
    environmentFiles = [ serverSecrets ];
    volumes = [
      "${kongConfig}:/home/kong/temp.yml:ro"
    ];
    ports = [
      "127.0.0.1:8010:8000/tcp"
    ];
    entrypoint = "/bin/bash";
    cmd = [
      "-c"
      ''
        eval "echo \"$(cat ~/temp.yml)\"" > ~/kong.yml && /docker-entrypoint.sh kong docker-start
      ''
    ];
    log-driver = "journald";
    extraOptions = [
      "--network-alias=kong"
      "--network=${network}"
    ];
  };
  systemd.services."podman-supabase-kong" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
    };
    unitConfig.Description = "Container supabase-kong generated by compose2nix.";
    after = [
      "podman-network-${network}.service"
    ];
    requires = [
      "podman-network-${network}.service"
    ];
    partOf = [
      "podman-compose-readest-root.target"
    ];
    wantedBy = [
      "podman-compose-readest-root.target"
    ];
  };

  virtualisation.oci-containers.containers."supabase-rest" = {
    image = image "postgrest";
    imageFile = imageFile "postgrest";
    environment = {
      "PGRST_APP_SETTINGS_JWT_EXP" = "3600";
      "PGRST_DB_ANON_ROLE" = "anon";
      "PGRST_DB_SCHEMAS" = "public";
      "PGRST_DB_USE_LEGACY_GUCS" = "false";
    };
    environmentFiles = [ serverSecrets ];
    cmd = [ "postgrest" ];
    log-driver = "journald";
    extraOptions = [
      "--network-alias=rest"
      "--network=${network}"
    ];
  };
  systemd.services."podman-supabase-rest" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
    };
    unitConfig.Description = "Container supabase-rest generated by compose2nix.";
    after = [
      "podman-network-${network}.service"
      "readest-migrations.service"
    ];
    requires = [
      "podman-network-${network}.service"
      "readest-migrations.service"
    ];
    partOf = [
      "podman-compose-readest-root.target"
    ];
    wantedBy = [
      "podman-compose-readest-root.target"
    ];
  };

  # Readest's base schema plus every incremental migration. The Supabase image
  # only runs init scripts on an empty volume, so this oneshot is also the
  # upgrade path (run it again after bumping readest-src / the client image).
  # The ledger lives in readest_meta, outside PostgREST's public schema.
  systemd.services.readest-migrations = {
    description = "Apply Readest schema and migrations to supabase-db";
    after = [ "podman-supabase-db.service" ];
    requires = [ "podman-supabase-db.service" ];
    wantedBy = [ "podman-compose-readest-root.target" ];
    partOf = [ "podman-compose-readest-root.target" ];
    path = [
      pkgs.podman
      pkgs.coreutils
      pkgs.gnugrep
    ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      TimeoutStartSec = "15min";
    };
    script = ''
      set -eu

      # Wait for the final Postgres server, not the temporary server used by
      # the image's init scripts. The final server is the one listening on TCP.
      until podman exec supabase-db \
        pg_isready -h 127.0.0.1 -p 5432 -U supabase_admin >/dev/null 2>&1; do
        sleep 2
      done

      # Re-apply the role passwords and DB JWT settings on every boot so a
      # changed POSTGRES_PASSWORD/JWT_SECRET in sops does not leave the
      # database roles on the old values. Both files are idempotent.
      podman exec supabase-db psql -U supabase_admin -d postgres \
        -v ON_ERROR_STOP=1 -f /readest-sql/roles.sql
      podman exec supabase-db psql -U supabase_admin -d postgres \
        -v ON_ERROR_STOP=1 -f /readest-sql/jwt.sql

      podman exec supabase-db psql -U supabase_admin -d postgres \
        -v ON_ERROR_STOP=1 -c "
          CREATE SCHEMA IF NOT EXISTS readest_meta;
          CREATE TABLE IF NOT EXISTS readest_meta.migrations (
            name text PRIMARY KEY,
            applied_at timestamp with time zone NOT NULL DEFAULT now()
          );
        "

      # schema.sql is not idempotent, so apply it exactly once. Keep the
      # sentinel insert in the same transaction as the schema itself.
      if ! podman exec supabase-db psql -U supabase_admin -d postgres -tAc \
        "SELECT 1 FROM readest_meta.migrations WHERE name = '000_schema.sql'" \
        | grep -q 1; then
        printf '%s\n' \
          '\i /readest-sql/schema.sql' \
          "INSERT INTO readest_meta.migrations (name) VALUES ('000_schema.sql');" \
          | podman exec -i supabase-db psql -U supabase_admin -d postgres \
              -v ON_ERROR_STOP=1 -1
      fi

      # Applies every migrations/*.sql in glob order and records it. Safe to
      # run after every upgrade; applied files are skipped by the ledger.
      podman exec supabase-db /bin/sh /readest-migrations.sh
    '';
  };

  # Create the bucket once RustFS is ready. nixpkgs' minio-client is marked
  # insecure/abandoned, so use awscli2 against the S3 API instead.
  systemd.services.readest-rustfs-setup = {
    description = "Create the Readest RustFS bucket";
    after = [ "podman-readest-rustfs.service" ];
    requires = [ "podman-readest-rustfs.service" ];
    wantedBy = [ "podman-compose-readest-root.target" ];
    partOf = [ "podman-compose-readest-root.target" ];
    path = [ pkgs.coreutils ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      EnvironmentFile = serverSecrets;
      TimeoutStartSec = "5min";
    };
    script = ''
      set -eu
      export AWS_ACCESS_KEY_ID="$MINIO_ROOT_USER"
      export AWS_SECRET_ACCESS_KEY="$MINIO_ROOT_PASSWORD"
      export AWS_DEFAULT_REGION="us-east-1"
      export AWS_EC2_METADATA_DISABLED="true"

      aws() {
        ${pkgs.awscli2}/bin/aws --endpoint-url http://127.0.0.1:9000 "$@"
      }

      until aws s3api list-buckets >/dev/null 2>&1; do
        sleep 2
      done
      aws s3api head-bucket --bucket ${bucket} >/dev/null 2>&1 \
        || aws s3api create-bucket --bucket ${bucket}
    '';
  };

  # Networks
  systemd.services."podman-network-${network}" = {
    unitConfig.Description = "Network ${network} generated by compose2nix.";
    path = [ pkgs.podman ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStop = "podman network rm -f ${network}";
    };
    script = ''
      podman network inspect ${network} || podman network create ${network}
    '';
    partOf = [ "podman-compose-readest-root.target" ];
    wantedBy = [ "podman-compose-readest-root.target" ];
  };

  # Volumes
  systemd.services."podman-volume-readest_db-config" = {
    unitConfig.Description = "Volume readest_db-config generated by compose2nix.";
    path = [ pkgs.podman ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      podman volume inspect readest_db-config || podman volume create readest_db-config
    '';
    partOf = [ "podman-compose-readest-root.target" ];
    wantedBy = [ "podman-compose-readest-root.target" ];
  };
  systemd.services."podman-volume-readest_db-data" = {
    unitConfig.Description = "Volume readest_db-data generated by compose2nix.";
    path = [ pkgs.podman ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      podman volume inspect readest_db-data || podman volume create readest_db-data
    '';
    partOf = [ "podman-compose-readest-root.target" ];
    wantedBy = [ "podman-compose-readest-root.target" ];
  };
  systemd.services."podman-volume-readest_rustfs-data" = {
    unitConfig.Description = "Volume readest_rustfs-data";
    path = [ pkgs.podman ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      podman volume inspect readest_rustfs-data || podman volume create readest_rustfs-data
    '';
    partOf = [ "podman-compose-readest-root.target" ];
    wantedBy = [ "podman-compose-readest-root.target" ];
  };
  systemd.services."podman-volume-readest_rustfs-logs" = {
    unitConfig.Description = "Volume readest_rustfs-logs";
    path = [ pkgs.podman ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      podman volume inspect readest_rustfs-logs || podman volume create readest_rustfs-logs
    '';
    partOf = [ "podman-compose-readest-root.target" ];
    wantedBy = [ "podman-compose-readest-root.target" ];
  };

  # Root service
  # When started, this will automatically create all resources and start
  # the containers. When stopped, this will teardown all resources.
  systemd.targets."podman-compose-readest-root" = {
    unitConfig = {
      Description = "Root target generated by compose2nix.";
    };
    wantedBy = [ "multi-user.target" ];
  };
}
